---
import { getCollection, type CollectionEntry } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import { SITE } from '../../consts';

export async function getStaticPaths() {
  // In dev mode, include drafts so you can preview unpublished article
  // skeletons. In production builds, drafts are excluded so bracketed
  // placeholder content never ships.
  const includeDrafts = import.meta.env.DEV;
  const all = await getCollection('articles', ({ data }) =>
    includeDrafts ? true : data.published
  );
  // Guard: the FAQ is rendered once, from frontmatter `faqs`, via FAQ.astro.
  // A hand-authored "## FAQ" in the body duplicates it (and its schema).
  // Fail the build rather than ship the duplicate.
  for (const e of all) {
    if (/^#{2,3}\s*(\d+\s*)?(quick\s*)?faq/im.test(e.body)) {
      throw new Error(
        `Article "${e.slug}" has an in-body FAQ heading. Remove it; the FAQ comes from the frontmatter "faqs" field.`
      );
    }
  }
  // Resolve related-article slugs to real titles at build time so the
  // "Keep reading" list shows headlines, not hyphenated slugs.
  const titleBySlug = new Map(all.map((e) => [e.slug, e.data.title]));
  return all.map((entry) => {
    const related = entry.data.relatedSlugs
      .filter((slug) => titleBySlug.has(slug))
      .map((slug) => ({ slug, title: titleBySlug.get(slug)! }));
    return {
      params: { slug: entry.slug },
      props: { entry, related },
    };
  });
}

interface Props {
  entry: CollectionEntry<'articles'>;
  related: { slug: string; title: string }[];
}

const { entry, related } = Astro.props;
const { Content } = await entry.render();
const data = entry.data;
const path = `/articles/${entry.slug}`;
---
<ArticleLayout
  title={data.title}
  seoTitle={data.seoTitle}
  description={data.description}
  path={path}
  publishedAt={data.publishedAt}
  updatedAt={data.updatedAt}
  author={data.author}
  quickAnswer={data.quickAnswer}
  faqs={data.faqs}
  howToSteps={data.howToSteps}
  section={{ name: 'Articles', url: `${SITE.url}/articles` }}
>
  <Content />

  {related.length > 0 && (
    <section class="keep-reading">
      <h2>Keep reading</h2>
      <ul>
        {related.map((r) => (
          <li><a href={`/articles/${r.slug}`}>{r.title}</a></li>
        ))}
      </ul>
    </section>
  )}
</ArticleLayout>
