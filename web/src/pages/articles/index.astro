---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Footer from '../../components/Footer.astro';
import BreadcrumbSchema from '../../components/schema/BreadcrumbSchema.astro';
import { SITE } from '../../consts';
import { splitTitle } from '../../lib/title';

// In dev mode, include drafts. In production, only published articles
// surface in the index.
const includeDrafts = import.meta.env.DEV;
const articles = (
  await getCollection('articles', ({ data }) =>
    includeDrafts ? true : data.published
  )
).sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());

const months: { label: string; items: typeof articles }[] = [];
for (const a of articles) {
  const label = a.data.publishedAt.toLocaleDateString('en-US', { month: 'long', year: 'numeric', timeZone: 'UTC' });
  const last = months[months.length - 1];
  if (last && last.label === label) last.items.push(a); else months.push({ label, items: [a] });
}

const collectionSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Pour Picks Blog, Bourbon Collector Guides',
  description: 'Guides and references for bourbon collectors covering storage, oxidation, valuation, identification, and more.',
  url: `${SITE.url}/articles`,
  inLanguage: SITE.locale,
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: articles.map((a, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: a.data.title,
      url: `${SITE.url}/articles/${a.slug}`,
    })),
  },
};
---
<BaseLayout
  title="Articles"
  description="Bourbon guides from Pour Picks on storing a bottle, oxidation, what a collection is worth, reading a label, and the words collectors use."
  path="/articles"
  full
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(collectionSchema)} />
    <BreadcrumbSchema crumbs={[{ name: 'Journal', url: `${SITE.url}/articles` }]} />
  </Fragment>

  <section class="hero-wrap tuck">
    <div class="hero hero-md">
      <img class="cover" src="/photos/hero-glass-linen.jpg" alt="A pour of bourbon in a rocks glass beside a linen cloth" />
      <div class="dots" aria-hidden="true"></div>
      <div class="shade" aria-hidden="true"></div>
      <div class="hero-body">
        <p class="eyebrow">Articles</p>
        <h1 class="t-elevated">Bourbon guides</h1>
        <p class="intro">Guides on <b>storing bourbon, valuing a collection and reading a label</b>, plus the words collectors use. If you came for the app, the <a href="/bourbon-inventory-app">bourbon inventory app</a> page covers it.</p>
      </div>
    </div>
  </section>
  {months.map((m) => (
    <section class="contained sticky-section month">
      <div class="sticky-copy">
        <p class="upper-tag">{m.items.length} {m.items.length === 1 ? 'article' : 'articles'}</p>
        <h2>{m.label}</h2>
      </div>
      <ol class="post-list">
        {m.items.map((a) => {
          const [head, rest] = splitTitle(a.data.title);
          return (
            <li><a href={`/articles/${a.slug}`}>
              <time>{a.data.publishedAt.toLocaleDateString('en-US', { month: 'short', day: 'numeric', timeZone: 'UTC' })}</time>
              <span><b>{head}</b>{rest && <span class="sub">{rest}</span>}</span>
            </a></li>
          );
        })}
      </ol>
    </section>
  ))}
  <Footer />
</BaseLayout>
