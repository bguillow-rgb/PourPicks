---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Footer from '../../components/Footer.astro';
import BreadcrumbSchema from '../../components/schema/BreadcrumbSchema.astro';
import { SITE } from '../../consts';

// In dev mode, include drafts. In production, only published articles
// surface in the index.
const includeDrafts = import.meta.env.DEV;
const articles = (
  await getCollection('articles', ({ data }) =>
    includeDrafts ? true : data.published
  )
).sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());

const collectionSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Pour Picks Blog, Bourbon Collector Guides',
  description: 'Guides and references for bourbon collectors covering storage, oxidation, valuation, identification, and more.',
  url: `${SITE.url}/articles`,
  inLanguage: SITE.locale,
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: articles.map((a, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: a.data.title,
      url: `${SITE.url}/articles/${a.slug}`,
    })),
  },
};
---
<BaseLayout
  title="Journal"
  description="The Pour Picks journal: field-tested references for bourbon collectors, covering storage, oxidation, valuation, identification, and the language of the hobby."
  path="/articles"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(collectionSchema)} />
    <BreadcrumbSchema crumbs={[{ name: 'Journal', url: `${SITE.url}/articles` }]} />
  </Fragment>

  <header class="article-head">
    <p class="article-kicker">Journal</p>
    <h1>The Pour Picks Journal</h1>
    <p class="article-dek">Field-tested references for bourbon collectors: how to store it, how to value it, how to read a label, and what the words on it mean. Looking for the app itself? Start with the <a href="/bourbon-inventory-app">bourbon inventory app</a> overview.</p>
  </header>

  {articles.length === 0 ? (
    <p>The first articles are being written now. Check back soon, or email <a href={`mailto:${SITE.supportEmail}`}>{SITE.supportEmail}</a> if there is a topic you want covered.</p>
  ) : (
    <ul class="blog-list">
      {articles.map((a) => (
        <li>
          <a href={`/articles/${a.slug}`}>{a.data.title}</a>
          <p>{a.data.description}</p>
        </li>
      ))}
    </ul>
  )}

  <Footer />
</BaseLayout>
