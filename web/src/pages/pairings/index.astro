---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Footer from '../../components/Footer.astro';
import allBottles from '../../data/pairings.json';
import { PAIRING_CATEGORIES } from '../../consts';

// American whiskey only. See PAIRING_CATEGORIES in consts.ts.
const bottles = allBottles.filter((b) => PAIRING_CATEGORIES.includes(b.category));
const sorted = [...bottles].sort((a, b) => a.display.localeCompare(b.display));
const total = bottles.reduce((n, b) => n + (b.pairings_with_reasons || []).length, 0);
---
<BaseLayout
  title="Bourbon Food Pairings: The Reason Each One Works"
  description={`Food pairings for ${bottles.length} bourbons, ${total} in all, each with the reason it works, plus full flavor profiles.`}
  path="/pairings"
>
  <main class="page">
    <h1>Bottle pairing guides</h1>
    <p><strong>{total} pairings across {bottles.length} bourbons, each with the reason it works.</strong></p>
    <p>
      Each guide starts from one bottle's flavor profile and names dishes that echo it, plus a few
      deep cuts to try once you've had the obvious ones.
    </p>
    <p>
      For the general principles, start with the
      <a href="/articles/bourbon-food-pairing-guide">bourbon food pairing guide</a>. If you're
      still working out what a bottle tastes like, the
      <a href="/articles/bourbon-flavor-wheel-guide">bourbon flavor wheel</a> and
      <a href="/articles/how-to-write-bourbon-tasting-notes">how to write tasting notes</a> cover
      the vocabulary these pages use.
    </p>
    <h2>Every pairing guide</h2>
    <ul>
      {sorted.map((b) => (
        <li>
          <a href={`/pairings/${b.slug}`}>What food pairs with {b.display}?</a>
          {' · '}{(b.flavors || []).slice(0, 3).map((f) => f.replace(/_/g, ' ')).join(', ')}, {b.proof} proof
        </li>
      ))}
    </ul>
    <h2>How these are built</h2>
    <p>
      Each pairing is written from one bottle's flavor profile in the Pour Picks catalog.
      AI assistants like Claude can look up the same data through the <a href="/mcp">Pour Picks MCP server</a>,
      and the full catalog with cellar tracking is in the <a href="/">Pour Picks app</a>.
    </p>
  </main>
  <Footer />
</BaseLayout>
