---
import { getCollection } from 'astro:content';
import { YouTube } from 'astro-embed';
import BaseLayout from '../layouts/BaseLayout.astro';
import QuickAnswer from '../components/QuickAnswer.astro';
import FAQ from '../components/FAQ.astro';
import Footer from '../components/Footer.astro';
import SoftwareApplicationSchema from '../components/schema/SoftwareApplicationSchema.astro';
import VideoObjectSchema from '../components/schema/VideoObjectSchema.astro';
import { SITE } from '../consts';
import { splitTitle } from '../lib/title';

// Latest 3 published articles for the homepage "From the Blog" teaser.
// Drafts are excluded automatically because they have published:false.
const latestArticles = (
  await getCollection('articles', ({ data }) => data.published)
)
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf())
  .slice(0, 3);

const quickAnswer =
  'Pour Picks is a hobby and lifestyle iOS app for adult bourbon collectors. ' +
  'It catalogs your cellar, scans bottles to identify what you own, ' +
  'tracks the value of your collection over time, and gives you a private ' +
  'journal to log every pour. It does not sell alcohol.';

const faqs = [
  {
    q: 'What is Pour Picks?',
    a:
      'Pour Picks is an iOS journal app for adult bourbon collectors. You catalog your cellar, scan bottles to identify them, track collection value, and log tasting notes, all in one private reference.',
  },
  {
    q: 'Is Pour Picks a retailer?',
    a:
      'No. Pour Picks does not sell alcohol, distribute alcohol, or encourage consumption. It is a reference, journal, and cellar catalog for collectors of legal drinking age.',
  },
  {
    q: 'How old do I have to be to use Pour Picks?',
    a:
      'Pour Picks is intended for adults of legal drinking age (21+ in the United States). A 21+ age gate is enforced on first launch.',
  },
  {
    q: 'How does the bottle scanner work?',
    a:
      'Point the camera at the front label. The Pour Concierge scanner uses Claude Vision to identify the distillery, expression, and proof, then matches against our catalog of thousands of American whiskeys. If recognition fails you can describe the bottle in words, search manually, or suggest a bottle to be added.',
  },
  {
    q: 'Is Pour Picks free?',
    a:
      'Yes, the core app is free. A Pro subscription (Cask Club) adds advanced collection tracking, the full Pour Concierge scanner, tasting reviews, and pairing recommendations. Pro is managed through Apple subscriptions and can be canceled any time in iOS Settings.',
  },
  {
    q: 'Is my collection data private?',
    a:
      'Yes. Your cellar, tasting reviews, scan history, and ratings are tied to your account and never shared, sold, or used for advertising. See the Privacy Policy for the full breakdown.',
  },
  {
    q: 'Will Pour Picks be available on Android?',
    a:
      'Pour Picks launched on iOS first. An Android release is on the roadmap but not yet scheduled.',
  },
];
---
<BaseLayout
  title={SITE.name}
  description={SITE.description}
  path="/"
  full
>
  <Fragment slot="head">
    <SoftwareApplicationSchema />
    <VideoObjectSchema />
    <link rel="apple-touch-icon" href="/icon.png" />
    <meta property="og:image" content={`${SITE.url}/icon.png`} />
  </Fragment>

  <section class="hero-wrap tuck">
    <div class="hero hero-lg hero-fade">
      <img class="cover" src="/photos/hero-rickhouse-aisle.jpg" alt="A rickhouse aisle lined with bourbon barrels" width="1600" height="1200" fetchpriority="high" />
      <div class="dots" aria-hidden="true"></div>
      <div class="shade" aria-hidden="true"></div>
      <div class="hero-body">
        <p class="eyebrow">{SITE.tagline}</p>
        <h1 class="t-welcome">My shelf outgrew the spreadsheet.</h1>
        <p class="intro">So I built Pour Picks. Point your phone at a bottle and it <b>reads the label</b>, figures out what it is, and files it in your cellar. From there it <b>tracks what the collection is worth</b> and <b>remembers how each pour tasted</b>.</p>
        <div class="actions">
          <a class="btn" href={SITE.appStoreUrl}>Download on the App Store</a>
        </div>
        <p class="fine">iPhone only. No ads, nothing you log leaves your account, and you have to be 21.</p>
      </div>
    </div>
  </section>

  <section class="contained gallery">
    <div class="intro-block">
      <p class="upper-tag">Features</p>
      <h2>Built for collectors</h2>
      <div class="intro-copy">
        <QuickAnswer text={quickAnswer} label="" />
      </div>
    </div>
    <div class="scroller" id="tiles">
      <article class="tile">
        <div class="media media--wood"><img src="/app/3_cellar.jpg" alt="The myCellar tab in Pour Picks" loading="lazy" /></div>
        <p class="caption"><b>Your cellar, organized.</b> Every bottle by distillery, expression, proof, age, and fill level. Snap the label and the Pour Concierge does the rest.</p>
      </article>
      <article class="tile">
        <div class="media media--aisle"><img src="/app/1_home.jpg" alt="The Pour Picks home screen with Build your Bourbon DNA" loading="lazy" /></div>
        <p class="caption"><b>Matched to your palate.</b> A three-question quiz learns what you reach for, then points you at bottles in the catalog worth chasing next.</p>
      </article>
      <article class="tile">
        <div class="media media--linen"><img src="/app/4_reviews.jpg" alt="The Reviews tab in Pour Picks" loading="lazy" /></div>
        <p class="caption"><b>A journal that remembers.</b> Log each pour with nose, palate, finish, served-with, and pour size. Your tasting history, searchable.</p>
      </article>
      <article class="tile">
        <div class="media media--wood"><img src="/app/2_browse.jpg" alt="Browse Bottles in Pour Picks, by distillery and char" loading="lazy" /></div>
        <p class="caption"><b>The whole American shelf.</b> Browse the full American-whiskey catalog. Filter by distillery, age, proof, or price.</p>
      </article>
    </div>
    <div class="paddles">
      <button type="button" aria-label="Previous" onclick="document.getElementById('tiles').scrollBy({left:-480,behavior:'smooth'})">&#8249;</button>
      <button type="button" aria-label="Next" onclick="document.getElementById('tiles').scrollBy({left:480,behavior:'smooth'})">&#8250;</button>
    </div>
  </section>

  <hr class="section-rule" />

  <section class="contained split">
    <div class="split-copy">
      <p class="upper-tag">Cask Club</p>
      <h2>How does Pour Picks make money?</h2>
      <p class="intro">Pour Picks is <b>free to download and use</b>. Cask Club, the paid tier, adds unlimited scans, full journaling, and collection value tracking.</p>
      <p class="intro">MSRP-aware pricing keeps a running total of what's resting on your shelf, with overrides for the bottles you paid over or under for. <b>No ads, no data selling, no alcohol promotion.</b> The app does not sell alcohol.</p>
      <a class="btn" href={SITE.appStoreUrl}>Download on iOS</a>
    </div>
    <div class="bento">
      <img class="tall" src="/photos/hero-glass-dark-wood.jpg" alt="A pour of bourbon in a rocks glass on a dark wood table" loading="lazy" />
      <div class="shot"><img src="/app/6_paywall.jpg" alt="The Cask Club membership screen in Pour Picks" loading="lazy" /></div>
      <div class="shot"><img src="/app/5_profile.jpg" alt="The Profile tab in Pour Picks" loading="lazy" /></div>
    </div>
  </section>

  <hr class="section-rule" />

  <section class="contained sticky-section">
    <div class="sticky-copy">
      <p class="upper-tag">From the Journal</p>
      <h2>From the Blog</h2>
      <p>Field-tested references for bourbon collectors.</p>
      <a class="more" href="/articles">All articles &#8250;</a>
    </div>
    <div class="post-grid">
      {latestArticles.map((a) => {
        const [head, rest] = splitTitle(a.data.title);
        return (
          <a class="post-tile" href={`/articles/${a.slug}`}>
            <time>{a.data.publishedAt.toLocaleDateString('en-US', { month: 'long', day: 'numeric', timeZone: 'UTC' })}</time>
            <span class="post-title">{head}</span>
            {rest && <span class="post-sub">{rest}</span>}
            <span class="more">Read it &#8250;</span>
          </a>
        );
      })}
      <div class="post-tile post-tile--video">
        <div class="demo-video"><YouTube id="29Ot-QKrZgs" title="Pour Picks in action" /></div>
        <div>
          <span class="post-title">See it in action</span>
          <span class="post-sub">A quick look at scanning a bottle and logging a pour.</span>
        </div>
      </div>
    </div>
  </section>

  <hr class="section-rule" />

  <section class="contained sticky-section faq-section">
    <div class="sticky-copy">
      <p class="upper-tag">FAQ</p>
      <h2>Frequently Asked Questions</h2>
    </div>
    <FAQ faqs={faqs} heading="" />
  </section>

  <Footer />
</BaseLayout>
