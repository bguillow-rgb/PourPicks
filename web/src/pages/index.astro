---
import { getCollection } from 'astro:content';
import { YouTube } from 'astro-embed';
import BaseLayout from '../layouts/BaseLayout.astro';
import QuickAnswer from '../components/QuickAnswer.astro';
import FAQ from '../components/FAQ.astro';
import Footer from '../components/Footer.astro';
import SoftwareApplicationSchema from '../components/schema/SoftwareApplicationSchema.astro';
import VideoObjectSchema from '../components/schema/VideoObjectSchema.astro';
import { SITE } from '../consts';
import { splitTitle } from '../lib/title';

// Latest 3 published articles for the homepage "From the Blog" teaser.
// Drafts are excluded automatically because they have published:false.
const latestArticles = (
  await getCollection('articles', ({ data }) => data.published)
)
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf())
  .slice(0, 3);

const quickAnswer =
  'Pour Picks is an iPhone app for bourbon collectors. It files the bottles ' +
  'you own, keeps a running value of the cellar, and lets you rate every pour.';

const faqs = [
  {
    q: 'What is Pour Picks?',
    a:
      'It\'s an iPhone app I built to keep track of my own bourbon collection. You scan bottles into your cellar and rate what you pour, and a short quiz learns your palate.',
  },
  {
    q: 'Is Pour Picks a retailer?',
    a:
      'No. Pour Picks doesn\'t sell or ship alcohol. It\'s for adults who want to keep track of what they own and what they\'ve tasted.',
  },
  {
    q: 'How old do I have to be to use Pour Picks?',
    a:
      'You have to be of legal drinking age, which is 21 in the United States. The app checks your age the first time you open it.',
  },
  {
    q: 'How does the bottle scanner work?',
    a:
      'Point the camera at the front label and the AI reads the distillery, expression and proof, then finds the bottle in the catalog. You can fix anything it got wrong before it goes in your cellar. It works on store picks and bottles with no barcode, and if a bottle isn\'t in the catalog you can save it as your own.',
  },
  {
    q: 'Is Pour Picks free?',
    a:
      'Yes. The free version holds 5 owned bottles and 5 label scans, and reviews are free for everyone. Cask Club is $5.99 a month or $49.99 a year and removes both limits. It\'s billed through Apple, and you can cancel any time in iOS Settings.',
  },
  {
    q: 'Is my collection data private?',
    a:
      'Yes. Your cellar, reviews, scan history and ratings are tied to your account. I don\'t sell them or use them for advertising. The Privacy Policy has the details.',
  },
  {
    q: 'Will Pour Picks be available on Android?',
    a:
      'Not yet. Pour Picks is iPhone only for now.',
  },
];
---
<BaseLayout
  title={SITE.name}
  description="I built Pour Picks to keep track of my own bourbon shelf. Scan a label to add a bottle, and take a short quiz to see what to buy next. Free on iPhone."
  path="/"
  full
>
  <Fragment slot="head">
    <SoftwareApplicationSchema />
    <VideoObjectSchema />
    <link rel="apple-touch-icon" href="/icon.png" />
    <meta property="og:image" content={`${SITE.url}/icon.png`} />
  </Fragment>

  <section class="hero-wrap tuck">
    <div class="hero hero-lg hero-fade">
      <img class="cover" src="/photos/hero-rickhouse-aisle.jpg" alt="A rickhouse aisle lined with bourbon barrels" width="1600" height="1200" fetchpriority="high" />
      <div class="dots" aria-hidden="true"></div>
      <div class="shade" aria-hidden="true"></div>
      <div class="hero-body">
        <p class="eyebrow">{SITE.tagline}</p>
        <h1 class="t-welcome">My shelf outgrew the spreadsheet.</h1>
        <p class="intro">So I built Pour Picks. Point your phone at a bottle and it <b>reads the label</b> and files it in your cellar, and you can fix anything it got wrong first. A short quiz <b>learns your palate</b> and <b>names the bottle to buy next</b>.</p>
        <div class="actions">
          <a class="btn" href={SITE.appStoreUrl}>Download on the App Store</a>
        </div>
        <p class="fine">Free on iPhone. There are no ads, and you have to be 21.</p>
      </div>
    </div>
  </section>

  <section class="contained gallery">
    <div class="intro-block">
      <p class="upper-tag">Features</p>
      <h2>What it does</h2>
      <div class="intro-copy">
        <QuickAnswer text={quickAnswer} label="" />
      </div>
    </div>
    <div class="scroller" id="tiles">
      <article class="tile">
        <div class="media media--wood"><img src="/app/3_cellar.jpg" alt="The myCellar tab in Pour Picks" loading="lazy" /></div>
        <p class="caption"><b>Scan it into your cellar.</b> The AI reads the label, including store picks and bottles with no barcode.</p>
      </article>
      <article class="tile">
        <div class="media media--aisle"><img src="/app/1_home.jpg" alt="The Pour Picks home screen with Build your Bourbon DNA" loading="lazy" /></div>
        <p class="caption"><b>Bourbon DNA.</b> A short quiz learns whether you lean sweet or spicy, easy sipper or cask strength. Then it names the bottle to buy next and why.</p>
      </article>
      <article class="tile">
        <div class="media media--linen"><img src="/app/4_reviews.jpg" alt="The Reviews tab in Pour Picks" loading="lazy" /></div>
        <p class="caption"><b>Reviews.</b> Rate the nose, palate and finish on anything you pour. Reviews are free for everyone.</p>
      </article>
      <article class="tile">
        <div class="media media--wood"><img src="/app/2_browse.jpg" alt="Browse Bottles in Pour Picks, by distillery and char" loading="lazy" /></div>
        <p class="caption"><b>The whole American shelf.</b> Browse American whiskey by distillery, age, proof or price.</p>
      </article>
    </div>
    <div class="paddles">
      <button type="button" aria-label="Previous" onclick="document.getElementById('tiles').scrollBy({left:-480,behavior:'smooth'})">&#8249;</button>
      <button type="button" aria-label="Next" onclick="document.getElementById('tiles').scrollBy({left:480,behavior:'smooth'})">&#8250;</button>
    </div>
  </section>

  <hr class="section-rule" />

  <section class="contained split">
    <div class="split-copy">
      <p class="upper-tag">Cask Club</p>
      <h2>What's in Cask Club?</h2>
      <p class="intro">Pour Picks is <b>free to download</b>. The free version holds 5 owned bottles and 5 label scans. Cask Club is $5.99 a month or $49.99 a year, and it removes both limits.</p>
      <p class="intro">It also adds Wishlist and Finished shelves and <b>Precision Match</b>: 10 questions, your top 10 bottles, and why each one fits.</p>
      <a class="btn" href={SITE.appStoreUrl}>Download on iOS</a>
    </div>
    <div class="bento">
      <img class="tall" src="/photos/hero-glass-dark-wood.jpg" alt="A pour of bourbon in a rocks glass on a dark wood table" loading="lazy" />
      <div class="shot"><img src="/app/6_paywall.jpg" alt="The Cask Club membership screen in Pour Picks" loading="lazy" /></div>
      <div class="shot"><img src="/app/5_profile.jpg" alt="The Profile tab in Pour Picks" loading="lazy" /></div>
    </div>
  </section>

  <hr class="section-rule" />

  <section class="contained sticky-section">
    <div class="sticky-copy">
      <p class="upper-tag">Articles</p>
      <h2>Latest articles</h2>
      <p>Guides on storing bourbon, valuing a collection and reading a label.</p>
      <a class="more" href="/articles">All articles &#8250;</a>
    </div>
    <div class="post-grid">
      {latestArticles.map((a) => {
        const [head, rest] = splitTitle(a.data.title);
        return (
          <a class="post-tile" href={`/articles/${a.slug}`}>
            <time>{a.data.publishedAt.toLocaleDateString('en-US', { month: 'long', day: 'numeric', timeZone: 'UTC' })}</time>
            <span class="post-title">{head}</span>
            {rest && <span class="post-sub">{rest}</span>}
            <span class="more">Read it &#8250;</span>
          </a>
        );
      })}
      <div class="post-tile post-tile--video">
        <div class="demo-video"><YouTube id="29Ot-QKrZgs" title="Pour Picks in action" /></div>
        <div>
          <span class="post-title">Watch the app</span>
          <span class="post-sub">Scanning a bottle and logging a pour.</span>
        </div>
      </div>
    </div>
  </section>

  <hr class="section-rule" />

  <section class="contained sticky-section faq-section">
    <div class="sticky-copy">
      <p class="upper-tag">FAQ</p>
      <h2>Common questions</h2>
    </div>
    <FAQ faqs={faqs} heading="" />
  </section>

  <Footer />
</BaseLayout>
