---
import BaseLayout from '../layouts/BaseLayout.astro';
import QuickAnswer from '../components/QuickAnswer.astro';
import Footer from '../components/Footer.astro';
import AboutPageSchema from '../components/schema/AboutPageSchema.astro';
import BreadcrumbSchema from '../components/schema/BreadcrumbSchema.astro';
import PersonSchema from '../components/schema/PersonSchema.astro';
import FAQPageSchema from '../components/schema/FAQPageSchema.astro';
import { SITE } from '../consts';

const aboutFaqs = [
  {
    q: 'Who built Pour Picks?',
    a: 'I did. I\'m Bob Guillow, and I build and run Pour Picks on my own. There\'s no outside investor, ad network or parent company, so I make the product and privacy decisions myself.',
  },
  {
    q: 'What is Timberline Ventures LLC?',
    a: 'Timberline Ventures LLC is my single-member LLC, and it owns and runs Pour Picks. That name is on the App Store developer page and in the app\'s legal agreements.',
  },
  {
    q: 'How can I contact the Pour Picks team?',
    a: `Email me at ${SITE.supportEmail}. Press, partnerships, feedback and review requests all go there, and I usually reply within a day. I don\'t answer DMs and there\'s no support chat.`,
  },
];

const quickAnswer =
  'Pour Picks is an iPhone app for bourbon collectors. It keeps track of what ' +
  'you own, what you\'ve poured and what your shelf is worth.';
---
<BaseLayout
  title="About"
  description="I'm Bob Guillow, and I build Pour Picks on my own. It's an iPhone app for keeping track of a bourbon collection."
  path="/about"
>
  <Fragment slot="head">
    <AboutPageSchema />
    <PersonSchema />
    <FAQPageSchema faqs={aboutFaqs} />
    <BreadcrumbSchema crumbs={[{ name: 'About', url: `${SITE.url}/about` }]} />
  </Fragment>

  <p class="brand">{SITE.name}</p>
  <h1>About Pour Picks</h1>

  <QuickAnswer text={quickAnswer} />

  <p class="about-lede">I'm Bob. My shelf outgrew the spreadsheet I kept it in, and I wanted one app that would catalog what I own, tell me what it's worth, and remember how each pour tasted. So I built Pour Picks. It's still just me.</p>

  <section class="is-isnt">
    <div class="is-col">
      <h2>What it is</h2>
      <ul>
        <li>It catalogs what you own by distillery, expression, proof, age and fill level.</li>
        <li>The AI reads a bottle's front label, and you can correct it before the bottle goes in your cellar.</li>
        <li>It keeps a running value of the collection, using MSRP or what you paid.</li>
        <li>You can rate every pour on nose, palate and finish.</li>
      </ul>
    </div>
    <div class="isnt-col">
      <h2>What it is not</h2>
      <ul>
        <li>It doesn't sell, ship or deliver alcohol.</li>
        <li>It isn't a marketplace, so there are no listings, auctions or allocation tools.</li>
        <li>There are no ads in the app.</li>
        <li>It isn't a social network, so there's no feed or leaderboard.</li>
        <li>It doesn't collect health, location or financial data. The <a href="/privacy">privacy policy</a> has the details.</li>
      </ul>
    </div>
  </section>

  <dl class="colophon">
    <div class="colophon-row">
      <dt>Who runs it</dt>
      <dd>Pour Picks is published under {SITE.legalEntity}, with no outside investor, and I'm the one who answers <a href={`mailto:${SITE.supportEmail}`}>{SITE.supportEmail}</a>.</dd>
    </div>
    <div class="colophon-row">
      <dt>How it makes money</dt>
      <dd>Pour Picks is free to download. Cask Club, the paid membership, is $5.99 a month or $49.99 a year, and it's how the app makes money. Apple handles billing, so payment details never reach my servers.</dd>
    </div>
    <div class="colophon-row">
      <dt>Editorial standards</dt>
      <dd>Articles are written from first-hand collecting and primary sources like distillery tech sheets, TTB filings and reference books. Facts link to their sources and opinions are labeled. The updated date only changes when an article does.</dd>
    </div>
    <div class="colophon-row">
      <dt>Responsible use</dt>
      <dd>Pour Picks doesn't promote drinking. Drinking too much is harmful to your health, and impaired driving is illegal everywhere the app is available. The full disclaimer is in the <a href="/terms">Terms of Use</a>.</dd>
    </div>
    <div class="colophon-row">
      <dt>Contact</dt>
      <dd>Press, partnerships and feedback all go to <a href={`mailto:${SITE.supportEmail}`}>{SITE.supportEmail}</a>. I usually reply within a day.</dd>
    </div>
  </dl>

  <Footer />
</BaseLayout>
