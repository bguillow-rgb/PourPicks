---
import { SITE, FOOTER_NAV } from '../consts';
const year = new Date().getFullYear();
---
<hr class="footer-rule" />
<nav class="footer-nav" aria-label="Site">
  {FOOTER_NAV.map((item, i) => (
    <>
      {i > 0 && <span aria-hidden="true"> &middot; </span>}
      <a href={item.href}>{item.label}</a>
    </>
  ))}
</nav>
<p class="footer">
  Questions? <a href={`mailto:${SITE.supportEmail}`}>{SITE.supportEmail}</a>
</p>
<p class="footer">
  {SITE.socials.map((s, i) => (
    <>
      {i > 0 && <span> &middot; </span>}
      <a href={s.url} rel="me noopener" target="_blank">{s.platform}: {s.label}</a>
    </>
  ))}
</p>
<p class="footer">&copy; {year} {SITE.name}, a {SITE.legalEntity} product. All rights reserved.</p>
