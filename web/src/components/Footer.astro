---
import { SITE } from '../consts';
const year = new Date().getFullYear();
---
<hr class="footer-rule" />
<p class="footer">
  Questions? <a href={`mailto:${SITE.supportEmail}`}>{SITE.supportEmail}</a>
</p>
<p class="footer">
  {SITE.socials.map((s, i) => (
    <>
      {i > 0 && <span> &middot; </span>}
      <a href={s.url} rel="me noopener" target="_blank">{s.platform}: {s.label}</a>
    </>
  ))}
</p>
<p class="footer">&copy; {year} {SITE.name}, a {SITE.legalEntity} product. All rights reserved.</p>
<p class="footer">
  <a href="https://findly.tools/pour-picks?utm_source=pour-picks" target="_blank" rel="noopener">
    <img src="https://findly.tools/badges/findly-tools-badge-light.svg" alt="Featured on Findly.tools" width="150" height="52" loading="lazy" />
  </a>
</p>
