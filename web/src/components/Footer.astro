---
import { SITE } from '../consts';
interface Props { band?: boolean }
const { band = true } = Astro.props;
const year = new Date().getFullYear();
const cols = [
  [['Features', '/features'], ['Pairings', '/pairings'], ['Inventory app', '/bourbon-inventory-app']],
  [['Articles', '/articles'], ['About', '/about'], ['Press', '/press']],
  [['Support', '/support'], ['Privacy', '/privacy'], ['Terms', '/terms']],
];
---
{band && (
  <section class="cta-wrap" aria-labelledby="cta-band-title">
    <div class="cta-band">
      <img class="cover" src="/photos/hero-glass-linen.jpg" alt="" loading="lazy" decoding="async" />
      <div class="dots" aria-hidden="true"></div>
      <div class="shade shade--side" aria-hidden="true"></div>
      <div class="cta-body">
        <p class="upper-tag">Free on iPhone</p>
        <h2 id="cta-band-title">Start your cellar</h2>
        <p class="intro">Pour Picks is free to download on iPhone. <b>The free version holds 5 bottles and 5 label scans.</b></p>
        <a class="btn" href={SITE.appStoreUrl}>Download on the App Store</a>
      </div>
    </div>
  </section>
)}
<footer class="site-footer">
  <div class="contained foot-grid">
    <div class="foot-brand">
      <a href="/" class="brand-mark">{SITE.name}</a>
      <p>{SITE.tagline}. Email me at <a href={`mailto:${SITE.supportEmail}`}>{SITE.supportEmail}</a>.</p>
    </div>
    {cols.map((c) => (
      <ul>{c.map(([l, h]) => <li><a href={h}>{l}</a></li>)}</ul>
    ))}
    <div class="foot-cta"><a class="btn btn-sm" href={SITE.appStoreUrl}>Download on iOS</a></div>
  </div>
  <div class="contained foot-fine">
    <p>&copy; {year} {SITE.name}, a {SITE.legalEntity} product. All rights reserved.</p>
    <p>{SITE.socials.map((s) => <a href={s.url} rel="me noopener" target="_blank">{s.platform} {s.label}</a>)}</p>
  </div>
</footer>
