---
import { SITE, NAV } from '../consts';
import OrganizationSchema from '../components/schema/OrganizationSchema.astro';
import WebSiteSchema from '../components/schema/WebSiteSchema.astro';
import Analytics from '../components/Analytics.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  // Canonical path on this site, e.g. '/about'. The full URL is constructed
  // from SITE.url. Leave empty on the homepage to use SITE.url itself.
  path?: string;
  // Set true on pages that should not appear in search results (drafts,
  // utility pages). Default is false.
  noindex?: boolean;
  // Set true on pages where the global Organization + WebSite schema should
  // NOT be emitted (e.g. when an article emits its own and we don\u2019t want
  // duplication). Default is false.
  suppressGlobalSchema?: boolean;
  // Set false to keep the brand out of the <title> tag. The suffix costs 12
  // characters against a ~60-character SERP budget, which is worth paying on
  // brand and product pages and not worth paying on articles that rank for
  // informational queries. og:title and twitter:title keep the brand either
  // way, since social cards have no length pressure.
  appendBrand?: boolean;
}

const {
  title,
  description = SITE.description,
  path = '',
  noindex = false,
  suppressGlobalSchema = false,
  appendBrand = true,
} = Astro.props;

const canonical = `${SITE.url}${path}`;
const brandedTitle =
  title === SITE.name ? `${SITE.name} | ${SITE.tagline}` : `${title} | ${SITE.name}`;
const fullTitle = appendBrand ? brandedTitle : title;
---
<!doctype html>
<html lang={SITE.locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}

    <meta property="og:type" content="website" />
    <meta property="og:title" content={brandedTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE.name} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={brandedTitle} />
    <meta name="twitter:description" content={description} />

    <link rel="icon" href="/favicon.png" type="image/png" />
    <meta name="theme-color" content={SITE.theme.bg} />

    <!-- The app's own type system (src/constants/theme.ts): Libre Baskerville
         (display serif + wordmark), EB Garamond (editorial italic), Outfit
         (body + UI + labels). display=swap so headlines are never invisible
         while the webfont loads. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Libre+Baskerville:ital,wght@0,400;0,700;1,400&family=EB+Garamond:ital,wght@0,400;0,500;1,400&family=Outfit:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />

    {!suppressGlobalSchema && <OrganizationSchema />}
    {!suppressGlobalSchema && <WebSiteSchema />}

    <Analytics />

    <slot name="head" />
  </head>
  <body>
    <div class="container">
      <header class="site-header">
        <a href="/" class="site-wordmark">{SITE.name}</a>
        <nav class="site-nav" aria-label="Main navigation">
          {NAV.map((item) => (
            <a
              href={item.href}
              aria-current={path === item.href ? 'page' : undefined}
            >{item.label}</a>
          ))}
        </nav>
      </header>
      <div class="label-rule" aria-hidden="true"></div>
      <slot />
    </div>
    <!-- AI plugin attribution (2026-10-03): a visitor who arrives from one of our
         MCP servers' links (utm_medium=ai_plugin) keeps that source for the session,
         and App Store links on the site carry Apple campaign tags so App Store
         Connect credits the install to the assistant (pt = Timberline provider token). -->
    <script is:inline>
      (function () {
        try {
          var key = "tv_ai_src";
          var q = new URLSearchParams(location.search);
          if (q.get("utm_medium") === "ai_plugin") {
            sessionStorage.setItem(key, (q.get("utm_source") || "other").replace(/[^a-z0-9_-]/gi, "").slice(0, 20));
          }
          var src = sessionStorage.getItem(key);
          if (!src) return;
          var tag = function () {
            document.querySelectorAll('a[href*="apps.apple.com"]').forEach(function (a) {
              try {
                var u = new URL(a.href);
                if (u.searchParams.get("ct")) return;
                u.searchParams.set("pt", "128774733");
                u.searchParams.set("ct", ("ai-" + src + "-site").slice(0, 40));
                u.searchParams.set("mt", "8");
                a.href = u.toString();
              } catch (e) {}
            });
          };
          if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", tag);
          else tag();
        } catch (e) {}
      })();
    </script>
  </body>
</html>
