---
import BaseLayout from './BaseLayout.astro';
import QuickAnswer from '../components/QuickAnswer.astro';
import FAQ from '../components/FAQ.astro';
import Footer from '../components/Footer.astro';
import ArticleSchema from '../components/schema/ArticleSchema.astro';
import HowToSchema from '../components/schema/HowToSchema.astro';
import BreadcrumbSchema from '../components/schema/BreadcrumbSchema.astro';
import { SITE } from '../consts';

interface Props {
  title: string;
  // Short form of the title written for the SERP, where anything past ~60
  // characters gets cut. The H1, schema, and breadcrumb keep the long title,
  // which reads better on the page. Falls back to title when unset.
  seoTitle?: string;
  description: string;
  path: string;
  publishedAt: Date;
  updatedAt?: Date;
  author: string;
  quickAnswer: string;
  faqs: { q: string; a: string }[];
  howToSteps?: { name: string; text: string }[];
  // Section label shown in breadcrumb between Home and the article (e.g.
  // \u201CGuides\u201D, \u201CHumidor\u201D). Optional.
  section?: { name: string; url: string };
}

const {
  title,
  seoTitle,
  description,
  path,
  publishedAt,
  updatedAt,
  author,
  quickAnswer,
  faqs,
  howToSteps,
  section,
} = Astro.props;

const fullUrl = `${SITE.url}${path}`;
const crumbs = [
  ...(section ? [section] : []),
  { name: title, url: fullUrl },
];

const formattedDate = (updatedAt ?? publishedAt).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---
<BaseLayout
  title={seoTitle ?? title}
  description={description}
  path={path}
  appendBrand={false}
>
  <Fragment slot="head">
    <ArticleSchema
      title={title}
      description={description}
      url={fullUrl}
      publishedAt={publishedAt}
      updatedAt={updatedAt}
      author={author}
    />
    {howToSteps && howToSteps.length > 0 && (
      <HowToSchema
        name={title}
        description={description}
        url={fullUrl}
        steps={howToSteps}
      />
    )}
    <BreadcrumbSchema crumbs={crumbs} />
  </Fragment>

  <header class="article-head">
    <p class="article-kicker">{section?.name ?? 'Journal'}</p>
    <h1>{title}</h1>
    <p class="article-dek">{description}</p>
    <p class="article-byline">
      By <a href="/about">{author}</a> &middot; {updatedAt ? 'Updated' : 'Published'} {formattedDate}
    </p>
  </header>

  <QuickAnswer text={quickAnswer} />

  <div class="article-body">
    <slot />
  </div>

  <FAQ faqs={faqs} />

  <Footer />
</BaseLayout>
