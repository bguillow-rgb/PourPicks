---
import BaseLayout from './BaseLayout.astro';
import QuickAnswer from '../components/QuickAnswer.astro';
import FAQ from '../components/FAQ.astro';
import Footer from '../components/Footer.astro';
import ArticleSchema from '../components/schema/ArticleSchema.astro';
import HowToSchema from '../components/schema/HowToSchema.astro';
import BreadcrumbSchema from '../components/schema/BreadcrumbSchema.astro';
import { SITE } from '../consts';

interface Props {
  title: string;
  // Short form of the title written for the SERP, where anything past ~60
  // characters gets cut. The H1, schema, and breadcrumb keep the long title,
  // which reads better on the page. Falls back to title when unset.
  seoTitle?: string;
  description: string;
  path: string;
  publishedAt: Date;
  updatedAt?: Date;
  author: string;
  quickAnswer: string;
  faqs: { q: string; a: string }[];
  howToSteps?: { name: string; text: string }[];
  // Section label shown in breadcrumb between Home and the article (e.g.
  // \u201CGuides\u201D, \u201CHumidor\u201D). Optional.
  section?: { name: string; url: string };
  headings?: { slug: string; text: string }[];
}

const {
  title,
  seoTitle,
  description,
  path,
  publishedAt,
  updatedAt,
  author,
  quickAnswer,
  faqs,
  howToSteps,
  section,
  headings = [],
} = Astro.props;

const fullUrl = `${SITE.url}${path}`;
const crumbs = [
  ...(section ? [section] : []),
  { name: title, url: fullUrl },
];

const formattedDate = (updatedAt ?? publishedAt).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---
<BaseLayout
  title={seoTitle ?? title}
  description={description}
  path={path}
  appendBrand={false}
  full
>
  <Fragment slot="head">
    <ArticleSchema
      title={title}
      description={description}
      url={fullUrl}
      publishedAt={publishedAt}
      updatedAt={updatedAt}
      author={author}
    />
    {howToSteps && howToSteps.length > 0 && (
      <HowToSchema
        name={title}
        description={description}
        url={fullUrl}
        steps={howToSteps}
      />
    )}
    <BreadcrumbSchema crumbs={crumbs} />
  </Fragment>

  <section class="hero-wrap tuck">
    <div class="hero hero-sm">
      <img class="cover" src="/photos/hero-glass-dark-wood.jpg" alt="" />
      <div class="dots" aria-hidden="true"></div>
      <div class="shade shade--heavy" aria-hidden="true"></div>
      <div class="hero-body">
        <p class="eyebrow"><a href="/articles">Articles</a></p>
        <h1 class="t-headline">{title}</h1>
        <p class="byline">By <a href="/about">{author}</a> &middot; {updatedAt ? 'Updated' : 'Published'} {formattedDate}</p>
      </div>
    </div>
  </section>
  <section class="contained sticky-section article-section">
    <aside class="sticky-copy toc">
      {headings.length > 0 && (
        <nav aria-label="On this page">
          <p class="upper-tag">On this page</p>
          {headings.map((h) => <a href={`#${h.slug}`}>{h.text}</a>)}
        </nav>
      )}
    </aside>
    <div class="article-main">
      <QuickAnswer text={quickAnswer} />
      <div class="article-body">
        <slot />
      </div>
      <FAQ faqs={faqs} />
    </div>
  </section>
  <Footer />
</BaseLayout>

